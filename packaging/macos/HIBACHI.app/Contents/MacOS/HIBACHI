#!/bin/bash
# HIBACHI.app launcher (macOS). Bootstraps the environment via the bundled
# install.sh when needed, then hands off to the self-updating Python launcher.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
RES="${HERE}/../Resources"
PLIST="${HERE}/../Info.plist"

INSTALL_DIR="${HIBACHI_HOME:-$HOME/HIBACHI}"
APP_DIR="${INSTALL_DIR}/app"
MAMBA="${INSTALL_DIR}/micromamba/bin/micromamba"
ENV_NAME="hibachi"
ENV_PREFIX="${INSTALL_DIR}/micromamba/envs/${ENV_NAME}"
ENV_PY="${ENV_PREFIX}/bin/python"
LOG="${INSTALL_DIR}/setup.log"
LAUNCH_LOG="${INSTALL_DIR}/launch.log"
MARKER="${INSTALL_DIR}/.bootstrapped_version"

notify() { osascript -e "display notification \"$1\" with title \"HIBACHI\"" >/dev/null 2>&1 || true; }
alert()  { osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with title \"HIBACHI\"" >/dev/null 2>&1 || true; }

# build_dmg.sh stamps CFBundleShortVersionString; MARKER records the version of
# the last successful bootstrap.
BUNDLE_VERSION="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "${PLIST}" 2>/dev/null || echo "0.0.0")"
INSTALLED_VERSION="$(cat "${MARKER}" 2>/dev/null || echo "")"

# Cheap (~ms) check, so it can run on every launch. Deep validation lives in
# install.sh, which is the only thing that can repair a shortfall.
env_usable() {
    [ -x "${ENV_PY}" ] || return 1
    "${ENV_PY}" -c "pass" >/dev/null 2>&1 || return 1
    return 0
}

# make_shortcuts.py::_make_macos() writes ~/Applications/HIBACHI.app -- correct
# for a `curl | bash` install, but a second identically-named app when this
# bundle exists. It execs a hardcoded env prefix with none of the checks below,
# so clicking it after any env problem dies silently.
remove_duplicate_launcher() {
    local stray="${HOME}/Applications/HIBACHI.app"
    [ -d "${stray}" ] || return 0
    case "${HERE}" in "${stray}"/*) return 0 ;; esac   # never delete ourselves
    rm -rf "${stray}" 2>/dev/null || return 0
    killall Dock >/dev/null 2>&1 || true               # refresh Launchpad
}
remove_duplicate_launcher

need_bootstrap=0
reason=""
if [ ! -d "${APP_DIR}/.git" ]; then
    need_bootstrap=1; reason="no application checkout"
elif [ ! -x "${MAMBA}" ]; then
    need_bootstrap=1; reason="no package manager"
elif ! env_usable; then
    need_bootstrap=1; reason="the Python environment is missing or unusable"
elif [ -z "${INSTALLED_VERSION}" ]; then
    # install.sh writes MARKER only on success, so no marker => never finished.
    need_bootstrap=1; reason="the previous setup did not finish"
elif [ "${BUNDLE_VERSION}" != "${INSTALLED_VERSION}" ]; then
    need_bootstrap=1; reason="a different version of the app was installed"
fi

if [ "${need_bootstrap}" = "1" ]; then
    if [ ! -f "${RES}/install.sh" ]; then
        alert "HIBACHI.app is incomplete (the bundled installer is missing). Please re-download it."
        exit 1
    fi

    mkdir -p "${INSTALL_DIR}"
    : > "${LOG}"
    notify "Setting up HIBACHI (${reason}). This takes a few minutes…"

    # Foreground: install.sh raises its own progress window, so the old
    # background run + notification heartbeat is no longer needed.
    HIBACHI_SKIP_SHORTCUT=1 bash "${RES}/install.sh" >"${LOG}" 2>&1
    install_rc=$?

    if [ "${install_rc}" -ne 0 ]; then
        alert "HIBACHI setup did not finish. Please send this log to support: ${LOG}"
        exit 1
    fi

    if ! env_usable; then
        alert "HIBACHI setup reported success but the environment is still unusable. Please send this log to support: ${LOG}"
        exit 1
    fi

    printf '%s\n' "${BUNDLE_VERSION}" > "${MARKER}"
    notify "Setup complete. Launching HIBACHI…"
fi

# Never exec into a missing env: the old `micromamba run` fallback here failed
# instantly and invisibly, which is the silent-vanish bug.
if ! env_usable; then
    alert "HIBACHI cannot start: the Python environment at ${ENV_PREFIX} is missing or unusable. Re-run setup from Terminal with:

HIBACHI_FORCE_REBUILD=1 bash '${RES}/install.sh'"
    exit 1
fi

# Keep one previous log so a crash-then-relaunch keeps the evidence.
if [ -f "${LAUNCH_LOG}" ]; then
    mv -f "${LAUNCH_LOG}" "${LAUNCH_LOG}.1" 2>/dev/null || true
fi

# Use the env's interpreter directly, not `micromamba run`: nothing needed on
# PATH, one process under the bundle's Dock tile, child output not swallowed.
# The redirect is inherited through run_app.py's os.execv into segment.py, so
# this one file captures launcher, dependency update and app.
export HIBACHI_HOME="${INSTALL_DIR}"
exec "${ENV_PY}" "${APP_DIR}/launcher/run_app.py" >>"${LAUNCH_LOG}" 2>&1
